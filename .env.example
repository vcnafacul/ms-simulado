# Valores para rodar no host (`yarn dev`). No compose do vcnafacul-stack
# (tickets/055), os endereços (Mongo, Redis, MinIO, ms-omr, api) são
# sobrescritos pelo próprio compose — não precisa editar nada aqui.
NODE_ENV=development
# O main.ts lê MS_PORT antes de PORT (MS_PORT é legado; prefira PORT).
PORT=3000
MONGODB=mongodb://localhost:27017/simulado

# Fila (Valkey Streams)
# redis: usa Valkey (produção) | memory: usa EventEmitter in-process (homol/local)
QUEUE_DRIVER=memory
REDIS_HOST=localhost
REDIS_PORT=6379

# Cartão resposta (Etapa 7 · Bloco 3) — storage R2/S3 (MinIO local)
AWS_ENDPOINT=http://localhost:9000
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin123
CARTAO_BUCKET=vcnafacul-cartoes

# Imagens de questão (Caderno · card 03) — leitura apenas. Sem default no código.
QUESTAO_BUCKET=simulado-questoes

# ms-omr (Etapa 12 · A3)
OMR_URL=http://localhost:8000

# Aviso à api (push do resultado do cartão, tickets/028; fim do recálculo por
# anulação, tickets/042). Opcionais: sem os dois, o ms não avisa. O segredo
# tem de ser IGUAL ao NOTIFICACAO_SECRET da api.
API_URL=http://localhost:3333
NOTIFICACAO_SECRET=troque-me

# Recálculo por anulação (tickets/042): pausa entre lotes de 50. Default 200.
# RECALCULO_PAUSA_MS=200

# Caderno (card 04) — geração de rascunho. Default: false em produção.
CADERNO_DRAFT_ENABLED=true

# Clone de ambiente Mongo -> local (script scripts/clone-env e `make seed-mongo` do stack)
# SOURCE_MONGODB: URI do ambiente remoto a clonar (homol/prod). READ-ONLY (so mongodump le).
#   Deve conter o nome do database no path. Ex: mongodb+srv://user:pass@cluster/simulado
SOURCE_MONGODB=
# Opcionais (defaults no script):
# CLONE_CONTAINER_NAME=mssimulado-clone
# CLONE_PORT=27018
# CLONE_NETWORK=mssimulado-clone-net
# CLONE_MONGO_IMAGE=mongo:7
# SLEEP_BETWEEN_OPS=1
